# Hand-written names for NewDark 2.48 SS2.exe (crc32 c8f2d1e4). These override the names tools/annotate.py generates.
# verified-against sha256 c7ff08c5a1837942410cc2328b4a6579ddb1d5a2678b8274db8b0347ce19823e SS2.exe, NewDark 2.48 retail (GOG and Steam copies are identical)
# <address> <kind> <name>  # notes   (addresses of function entry points, as in the original exe)
0x006017d0 func render_frame_world        # builds the render camera from the player camera object (*0xa3acb8) and draws the 3D frame
0x00601430 func render_scene_from_camera  # eax -> {float x,y,z; u32 cell; u16 bank,pitch; u16 heading}; copies it to 0xa57e00
0x006a8750 func detect_simd_features      # IsProcessorFeaturePresent -> 0xa46a04 (SSE level), 0xa46a08 (MMX), 0xa46a0c (3DNow)
0x00519930 func blend_pixels_simd         # has an SSE2 path used when *0xa46a04 >= 2
0x006c6700 func memset_large              # SSE2 non-temporal path for >= 3 MB when *0xa46a04 >= 2
0x006a1380 func res_fopen                 # ecx -> mode string; opens a file through the resource search path
0x006dae90 func movie_io_open             # lgvid callback: open (returns a 32-byte handle)
0x006daed0 func movie_io_size             # lgvid callback: file length
0x006daf30 func movie_io_read             # lgvid callback: fread(buf, 1, size, handle->fp)
0x006daf70 func movie_io_seek             # lgvid callback: fseek(handle->fp, off, whence)
0x006c8600 func d3d_display_flip          # D3D display device vtable (0x787820) slot 0x14
0x006c8bb0 func d3d_display_lock          # slot 0x18
0x006c8e10 func d3d_display_unlock        # slot 0x1c
0x006c8700 func d3d_display_end_frame     # slot 0x20
0x006c9e30 func d3d_display_set_overlay   # slot 0x3c
0x006c9ee0 func d3d_display_end_overlay   # slot 0x40
0x006f6b98 func security_check_cookie     # MSVC /GS check

# Key-binding command handlers (take the command name and an argument string; seen running in a recorded play session, with the command name as their argument)
0x00428ca0 func cmd_crouch                    # key command "crouch": argument "1.0" = press, "0.0" = release
0x004284e0 func cmd_leanleft                  # key command "leanleft" / "+leanleft"
0x00428730 func cmd_leanright                 # key command "leanright" / "+leanright"
0x00428bd0 func cmd_jump                      # key command "jump" / "+jump": atof(arg) != 0 = press; ran only under the jump tag in the recording
0x00427980 func cmd_forward                   # key command "forward" / "+forward": same handler shape as cmd_crouch (atof of the argument)
0x00427d60 func cmd_sidestep                  # key command "sidestep" / "+sidestep": same handler shape (atof of the argument)
0x0043b220 func cmd_fire_weapon               # key command "fire_weapon" / "+fire_weapon": atof of the argument, then the fire path
0x00506420 func new_sAISignalMsg              # message factory from the class table at 0x83db3c: allocates 0x3c bytes, sets vtables, returns the interface pointer (was mislabelled sPersistent::ctor)
0x00506530 func new_sAIPatrolPointMsg         # message factory, table entry "sAIPatrolPointMsg" (same shape: new + vtable init)
0x005065a0 func new_sAIModeChangeMsg          # message factory, table entry "sAIModeChangeMsg"
0x00506600 func new_sAIAlertnessMsg           # message factory, table entry "sAIAlertnessMsg"
0x005066d0 func new_sAIHighAlertMsg           # message factory, table entry "sAIHighAlertMsg"
0x005067b0 func new_sAIResultMsg              # message factory, table entry "sAIResultMsg"
# object (model) rendering and lighting, traced with SS2PORT_DRAWTRACE (draw call chains and entry traces) and read in the code
0x00627280 func md_set_model               # eax -> LGMD model; caches its section pointers (0xa45980 subobjects ... 0xa45994 light entries, 0xa45998 normals)
0x006279e0 func md_set_buffers             # edi -> model, esi -> point buffer: sets the point (0xa459a8) and per-light-entry result (0xa459ac) buffers
0x00627a40 func md_setup_subobject         # transforms a subobject's points, then calls the light callback [0xa45ed8](count, out, light entries, verts, points)
0x006274f0 func md_render_node             # recursive walk of the model's node tree
0x00627be0 func md_render_polygon          # copies each vertex's lighting result into its point (+0x20, or +0x20/+0x2c/+0x30 in RGB mode) and draws
0x005ed7d0 func obj_light_callback         # the md light callback (installed by 0x608440); the object's point lights are at 0x93fe48 (0x30 each: xyz, -, rgb, -, -, radius; count 0x940458), ambient 0xa3b62c + 0x940448..50: 0x5ea980 for the scene lights, then self-illumination
0x005ea980 func obj_light_points           # per-vertex lighting kernel: count, out, packed normals (stride 8), point indices, verts
0x006380a0 func r3_draw_polygon_list       # (polygons of 0x164 bytes, vertex count 3..50) through the renderer interface (vtable 0x77efb0)
0x0063f7f0 func r3_flush_batch             # renderer interface slot 0x04: flushes the queued polygons (slot 0xac, 0x650f40) to Direct3D
0x00608440 func obj_render_pass            # draws the scene's objects: installs the md light callback, renders, then flushes the polygons it queued (0x6478f0)
